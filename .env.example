# Core
NOESEK_DATABASE_URL=sqlite+aiosqlite:///./noesek.db
NOESEK_PUBLIC_BASE_URL=https://your-host.example
NOESEK_LOG_LEVEL=INFO

# WhatsApp Cloud API (leave blank for dry-run outbound)
NOESEK_VERIFY_TOKEN=choose-a-long-random-string
NOESEK_WHATSAPP_ACCESS_TOKEN=
NOESEK_WHATSAPP_PHONE_NUMBER_ID=
NOESEK_META_APP_SECRET=

# Model provider (OpenAI-compatible)
NOESEK_LLM_BASE_URL=https://api.openai.com/v1
NOESEK_LLM_API_KEY=
NOESEK_LLM_MODEL=
NOESEK_LLM_TIMEOUT_SECONDS=90
NOESEK_LLM_MAX_RETRIES=3

# Optional tools
NOESEK_BRAVE_SEARCH_API_KEY=
NOESEK_SANDBOX_IMAGE=python:3.12-alpine

# Context / behavior tuning
NOESEK_HISTORY_LIMIT=24
NOESEK_MEMORY_LIMIT=12
NOESEK_MAX_CONTEXT_CHARS=12000
NOESEK_APPROVAL_TTL_HOURS=24
NOESEK_TASK_MAX_ATTEMPTS=3
NOESEK_RATE_LIMIT_MESSAGES=20
NOESEK_RATE_LIMIT_WINDOW_SECONDS=60
NOESEK_METRICS_ENABLED=true
